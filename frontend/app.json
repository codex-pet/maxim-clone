{
  "expo": {
    "name": "GoRyde",
    "slug": "maxim-clone",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/img/goryde-splash-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/img/goryde-splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFC"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/img/goryde-splash-icon.png",
        "backgroundColor": "#F8FAFC"
      },
      "package": "com.maximclone.app",
      "permissions": [
        "SEND_SMS",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/img/goryde-splash-icon.png"
    },
    "plugins": [
      "expo-font",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow GoRyde to access your microphone for voice translation."
        }
      ]
    ]
  }
}
